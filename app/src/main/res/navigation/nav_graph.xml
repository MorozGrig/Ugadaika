<?xml version="1.0" encoding="utf-8"?>
<!-- Навигационный граф: MenuFragment -> GameFragment, RecordsFragment -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/menuFragment">

    <!-- Экран 1: Главное меню -->
    <fragment
        android:id="@+id/menuFragment"
        android:name="ru.example.guessnumber.ui.MenuFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_menu">

        <action
            android:id="@+id/action_menu_to_game"
            app:destination="@id/gameFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <action
            android:id="@+id/action_menu_to_records"
            app:destination="@id/recordsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <!-- Экран 2: Игра -->
    <fragment
        android:id="@+id/gameFragment"
        android:name="ru.example.guessnumber.ui.GameFragment"
        android:label="@string/title_game"
        tools:layout="@layout/fragment_game">

        <action
            android:id="@+id/action_game_to_menu"
            app:destination="@id/menuFragment"
            app:popUpTo="@id/menuFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Экран: Таблица рекордов -->
    <fragment
        android:id="@+id/recordsFragment"
        android:name="ru.example.guessnumber.ui.RecordsFragment"
        android:label="@string/title_records"
        tools:layout="@layout/fragment_records" />

</navigation>
